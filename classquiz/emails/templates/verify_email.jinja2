<!DOCTYPE html>
<html lang="en">
  <body style="margin:0;padding:0;background:#0b0f1a;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#e2e8f0;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background:#0b0f1a;padding:32px 16px;">
      <tr>
        <td align="center">
          <table width="100%" style="max-width:520px;background:#111827;border:1px solid #1e293b;border-radius:16px;padding:32px;">
            <tr>
              <td>
                <p style="margin:0 0 8px;font-size:12px;letter-spacing:0.35em;color:#e8b931;text-transform:uppercase;">CMA Clash</p>
                <h1 style="margin:0 0 16px;font-size:28px;color:#f8fafc;">Confirm your email</h1>
                <p style="margin:0 0 24px;line-height:1.6;color:#94a3b8;">
                  Welcome to CMA Clash. Verify your email to save progress, join battles, and open your dashboard.
                </p>
                <p style="margin:0 0 32px;text-align:center;">
                  <a href="{{ verify_url }}" style="display:inline-block;background:#38bdf8;color:#0b0f1a;font-weight:600;text-decoration:none;padding:14px 28px;border-radius:10px;">
                    Verify email address
                  </a>
                </p>
                <p style="margin:0;font-size:13px;line-height:1.5;color:#64748b;">
                  This link expires in {{ expiry_hours }} hours. If you did not create an account, you can ignore this message.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
