{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://api.example.com/api/:path*"
		},
		{
			"source": "/socket.io",
			"destination": "https://api.example.com/socket.io"
		},
		{
			"source": "/socket.io/:path*",
			"destination": "https://api.example.com/socket.io/:path*"
		},
		{
			"source": "/openapi.json",
			"destination": "https://api.example.com/openapi.json"
		},
		{
			"source": "/rapidoc",
			"destination": "https://api.example.com/rapidoc"
		},
		{
			"source": "/rapidoc/:path*",
			"destination": "https://api.example.com/rapidoc/:path*"
		}
	]
}
