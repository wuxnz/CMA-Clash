{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "pnpm install",
	"buildCommand": "node scripts/write-vercel-config.mjs && pnpm run build:app",
	"framework": null,
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://YOUR-BACKEND.example.com/api/:path*"
		},
		{
			"source": "/socket.io",
			"destination": "https://YOUR-BACKEND.example.com/socket.io"
		},
		{
			"source": "/socket.io/:path*",
			"destination": "https://YOUR-BACKEND.example.com/socket.io/:path*"
		},
		{
			"source": "/openapi.json",
			"destination": "https://YOUR-BACKEND.example.com/openapi.json"
		}
	]
}
